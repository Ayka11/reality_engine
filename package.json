{
  "name": "reality-engine-v2",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "deploy": "netlify deploy --prod --dir=dist",
    "hf:smoke": "node scripts/hf-smoke-check.mjs",
    "build:hf:cpu": "npm run build",
    "hf:cpu:check": "node scripts/hf-cpu-check.mjs",
    "hf:browser:acceptance": "node scripts/browser-acceptance.mjs",
    "test:brushes": "node scripts/check-brush-math.mjs && node scripts/check-brush-geometry.mjs",
    "test:world-field": "node scripts/check-world-field-contract.mjs",
    "test:presets": "node scripts/check-preset-contract.mjs",
    "test:preset-field": "node scripts/check-preset-field-provenance.mjs",
    "test:construction": "node scripts/check-world-construction-contract.mjs",
    "test:law-physics": "node scripts/check-law-physics-contract.mjs",
    "test:legacy-field-bridge": "node scripts/check-legacy-field-bridge.mjs",
    "test:field-profile": "node scripts/check-scientific-field-profile.mjs",
    "test:mutable-field-profile": "node scripts/check-mutable-field-profile.mjs",
    "test:field-spatial-pattern": "node scripts/check-scientific-field-spatial-pattern.mjs",
    "test:legacy-sculpt-adapter": "node scripts/check-legacy-sculpt-runtime-adapter.mjs",
    "test:authoritative-sculpt-transaction": "node scripts/check-authoritative-sculpt-transaction.mjs",
    "test:world-persistence-failures": "node scripts/check-world-persistence-failures.mjs",
    "audit:report": "node scripts/report-npm-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.184.1",
    "@webgpu/types": "^0.1.70",
    "playwright": "^1.60.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "@types/pako": "^2.0.4",
    "@xyflow/react": "^12.10.2",
    "bitecs": "^0.3.40",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "pako": "^2.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.164.0",
    "ws": "^8.17.0",
    "zustand": "^5.0.13"
  }
}
